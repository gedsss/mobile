# IP da máquina que roda o backend, na mesma rede do celular (não use "localhost"
# — o Expo Go num aparelho físico não enxerga o localhost do PC). Descubra com
# `ipconfig` (Windows) / `ifconfig` (macOS/Linux). No navegador (`npm run web`)
# rodando na mesma máquina do backend, "http://localhost:3000" também serve.
EXPO_PUBLIC_API_URL=http://SEU-IP-LOCAL:3000

# false (padrão) = fala de verdade com o backend em EXPO_PUBLIC_API_URL.
# true = dados fictícios em memória, sem precisar do backend/Postgres rodando
#        (útil só para navegar pelas telas offline).
EXPO_PUBLIC_USE_MOCKS=false
